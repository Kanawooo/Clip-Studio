{
  "name": "pi-video-backend",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Windows local AI video editing backend around the native Pi Coding Agent SDK",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "postinstall": "node scripts/patch-puppeteer-windows.mjs",
    "dev:server": "set PI_VIDEO_DEV=1&& tsx watch src/index.ts",
    "dev:web": "npm --prefix web run dev",
    "dev": "concurrently -n \"backend,frontend\" -c \"blue,cyan\" \"npm run dev:server\" \"npm run dev:web\"",
    "build:server": "tsc && node scripts/generate-model-catalog.mjs",
    "build:web": "npm --prefix web run build",
    "build": "node scripts/clean-build.mjs && npm run build:server && npm run build:web",
    "prestart": "npm run build",
    "start": "node dist/index.js",
    "package:release": "node scripts/package-release.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@earendil-works/pi-ai": "0.84.4",
    "@earendil-works/pi-coding-agent": "0.84.4",
    "hyperframes": "0.8.4"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
